{
  "schema": "sa.plugin/1",
  "name": "http-server",
  "version": "0.1.0",
  "source": {
    "type": "local",
    "path": "."
  },
  "abi": {
    "plugin": 1,
    "saasm": ">=0.4.0"
  },
  "artifacts": {
    "linux-x86_64": {
      "path": "zig-out/lib/libhttp-server.so"
    },
    "windows-x86_64": {
      "path": "zig-out/bin/http-server.dll"
    }
  },
  "interfaces": {
    "sai": { "path": "sa_http_server.sai" }
  },
  "skills": ["http.server"],
  "permissions": {
    "fs": [
      { "op": "metadata", "path": "$SA_PLUGINS_HOME/**" }
    ],
    "net": [
      { "url": "http://localhost", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
      { "url": "http://127.0.0.1", "methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] }
    ],
    "env": ["HOME", "TMPDIR", "TMP", "TEMP", "SA_*"],
    "process": { "spawn": false, "exec": [] }
  },
  "dependencies": {}
}
